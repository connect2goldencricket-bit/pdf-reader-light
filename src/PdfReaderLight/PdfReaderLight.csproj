<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PdfReaderLight</AssemblyName>
    <RootNamespace>PdfReaderLight</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PdfReaderLight</Product>
    <Description>Lightweight PDF reader for Windows (PDFium + WinForms)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfReaderCore\PdfReaderCore.csproj" />
  </ItemGroup>

</Project>
